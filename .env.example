# .env.example — copy to .env and fill in real values before running the app.
# All variables prefixed with VITE_ are inlined into the browser bundle by Vite.
# Never put secrets (client secrets, session secrets) in VITE_-prefixed vars.

# ── OIDC / Authentication (client-side PKCE flow) ─────────────────────────────
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=

# ── Backend API ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL=

# ── Server-side only (never expose to the browser) ───────────────────────────
# These are consumed by the backend/server process, not the Vite frontend build.
OIDC_CLIENT_SECRET=
SESSION_SECRET=
PORT=
NODE_ENV=
