# .env.example — copy to .env and fill in real values before running the app.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://taskmanagement:taskmanagement@localhost:5432/taskmanagement

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET signs the login session cookie — use a long random string.
JWT_SECRET=
# Credentials for the single seeded user (run `npm run db:seed` after setting these).
SEED_USERNAME=
SEED_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
